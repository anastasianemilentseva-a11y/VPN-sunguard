# Скопируй в .env и заполни. Сам .env в git не попадает.

# Токен бота от @BotFather
BOT_TOKEN=
# Твой номер в Telegram (узнать: написать @userinfobot)
ADMIN_ID=
# Адрес сервера и порт WireGuard, как в Endpoint у клиентов: 1.2.3.4:51820
SERVER_ENDPOINT=

# Дальше можно не трогать
WG_INTERFACE=wg0
# WG_CONFIG=/etc/wireguard/wg0.conf
WG_BIN=wg
CLIENT_DNS=1.1.1.1
CLIENT_MTU=
CLIENT_ALLOWED_IPS=0.0.0.0/0
MAX_DEVICES=3
DB_PATH=/opt/vpn-bot/vpnbot.sqlite3
